{
  "name": "kouch-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:realtime\"",
    "dev:web": "set -a; [ -f ./.env.local ] && . ./.env.local; set +a; npm run dev --workspace @kouch/web",
    "dev:realtime": "npm run dev --workspace @kouch/realtime",
    "dev:legacy-socket": "tsx server/server.ts",
    "build": "npm run build:web && npm run build:realtime",
    "build:web": "set -a; [ -f ./.env.local ] && . ./.env.local; set +a; npm run build --workspace @kouch/web",
    "build:realtime": "npm run build --workspace @kouch/realtime",
    "lint": "set -a; [ -f ./.env.local ] && . ./.env.local; set +a; npm run lint --workspace @kouch/web",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run test --workspace @kouch/contracts && npm run test --workspace @kouch/game-engine && npm run test --workspace @kouch/web",
    "test:integration": "npm run test --workspace @kouch/realtime",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "kill:3001": "lsof -ti :3001 | xargs kill -9 || true"
  },
  "devDependencies": {
    "@kouch/game-content": "0.1.0",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^20",
    "concurrently": "^8.2.0",
    "http-proxy": "^1.18.1",
    "socket.io": "^4.7.2",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
